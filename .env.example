DJANGO_SECRET_KEY=replace-with-a-local-random-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=../db.sqlite3
COUNTRIES_API_URL=https://countries.trevorblades.com/graphql
COUNTRIES_CONNECT_TIMEOUT=3
COUNTRIES_READ_TIMEOUT=5
# PostgreSQL: DB_ENGINE=django.db.backends.postgresql; instalar psycopg.
# SQL Server: DB_ENGINE=mssql; instalar backend compatible, pyodbc y driver ODBC.
